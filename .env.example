# Poker-master — variables d'environnement (copier vers .env / config.local.json)
# Ne jamais committer .env ni config.local.json (gitignore)

# Base de données — remplace __CHANGE_ME__ par un mot de passe fort
POKER_DB_DSN=postgresql://poker_bot:__CHANGE_ME__@localhost:5432/poker_db
POKER_DB_MODE=auto
POKER_OBSERVATION_STORE_PATH=log/observation_store.json

# Serveur GTO
POKER_GTO_SERVER_URL=http://127.0.0.1:8765/v2/solve
POKER_RUNTIME_BRIDGE_DIR=log/runtime_bridge
POKER_RUNTIME_HISTORY_PATH=log/runtime_history.jsonl

# LLM / auto-annotator (laisser vide si non utilisé)
OPENAI_API_KEY=
GROQ_API_KEY=
POKER_AUTO_ANNOTATOR_BASE_URL=http://127.0.0.1:8080/v1

# Hardware — forcer un profil pour CI/bench (auto par défaut)
# Valeurs: auto | 3g | 6g | 12g | 16g | 24g | cpu
POKER_GPU_PROFILE=auto
POKER_VRAM_CAP=
POKER_YOLO_MODEL=

# Tests
POKER_TEST_DSN=postgresql://poker_bot:__CHANGE_ME__@localhost:5432/poker_db
POKER_RUN_POSTGRES_TESTS=0
