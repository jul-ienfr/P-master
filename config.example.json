{
  "auto_annotator": {
    "providers": [
      {
        "api_key": "${POKER_AUTO_ANNOTATOR_API_KEY:-}",
        "base_url": "${POKER_AUTO_ANNOTATOR_BASE_URL:-http://127.0.0.1:8080/v1}",
        "model": "gpt-5.4"
      },
      {
        "api_key": "${GROQ_API_KEY:-}",
        "base_url": "https://api.groq.com/openai/v1",
        "model": "llama-3.2-90b-vision-preview"
      },
      {
        "api_key": "${OPENAI_API_KEY:-}",
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-4o"
      }
    ]
  },
  "bot": {
    "target_fps": 30,
    "prefer_window_capture": false,
    "time_budget_ms": 1000,
    "pot_ocr_refresh_interval_s": 0.12,
    "pot_crop_change_threshold": 0.85,
    "live_debounce_reset_sleep_s": 0.03,
    "live_debounce_stable_window_s": 0.12,
    "live_debounce_poll_sleep_s": 0.02,
    "window_title_keywords": "NLHE|Hold'em No Limit|Connecté en tant que|PokerStars",
    "humanization": {
      "enabled": true,
      "input_backend": "win32",
      "seed": null,
      "mouse": {
        "speed_px_s": [800, 1500],
        "move_min_duration_s": 0.18,
        "move_max_duration_s": 0.85,
        "overshoot_probability": 0.35,
        "overshoot_amplitude_px": 15,
        "hover_s": [0.10, 0.40],
        "hover_jitter_px": 3.0,
        "divergence_px": [20, 60],
        "click_down_s": [0.04, 0.12]
      },
      "typing": {
        "key_delay_s": [0.02, 0.09],
        "inter_key_delay_s": [0.04, 0.14],
        "group_pause_probability": 0.12,
        "group_pause_s": [0.25, 0.80],
        "typo_probability": 0.02,
        "select_ctrl_a_probability": 0.50,
        "select_triple_click_probability": 0.10,
        "legacy_double_enter": false
      },
      "think": {
        "fold_median_s": 1.2,
        "passive_median_s": 2.5,
        "aggressive_median_s": 4.5,
        "sigma": 0.45,
        "preflop_factor": 0.75,
        "big_pot_threshold_bb": 8.0,
        "big_pot_bb_reference": 0.0,
        "low_confidence_threshold": 0.5,
        "low_confidence_factor": 1.30,
        "min_think_time_s": 0.15,
        "max_think_time_s": 12.0
      },
      "session_rhythm": {
        "enabled": true,
        "micro_pause_probability": 0.05,
        "micro_pause_s": [3.0, 15.0],
        "fatigue_enabled": true,
        "fatigue_drift_per_hour": 0.06,
        "fatigue_max_drift": 0.20
      }
    },
    "go_live_gate": {
      "min_decision_count": 20,
      "max_block_rate": 0.5,
      "max_fallback_rate": 0.5,
      "max_rolling_latency_ms": 2500.0,
      "max_incident_count": 10,
      "min_readiness_score": 0.6,
      "max_non_actionable_readiness_rate": 0.5,
      "max_invalid_validation_rate": 0.5
    },
    "jev_gate": {
      "mode": "observer",
      "model": "jev-1.13-free",
      "base_url": "http://127.0.0.1:4000",
      "timeout_s": 0.8
    },
    "site_profiles": {
      "PokerStars": {
        "default_bb": 200,
        "ev_bb_dollars": null,
        "stake_regex": "\\d+[/,](\\d+)\\b",
        "title_regex": null,
        "window_class": "PokerStarsTableFrameClass",
        "process_name": "PokerStars.exe"
      },
      "Winamax": {
        "default_bb": 100,
        "ev_bb_dollars": null,
        "stake_regex": "\\d+[/,](\\d+)\\b",
        "title_regex": null,
        "window_class": null,
        "process_name": null
      }
    },
    "ghost_clicks_enabled": false,
    "active_learning_limits": {
      "max_images_per_session": 50,
      "min_interval_s": 30.0
    },
    "max_tables": 4,
    "table_scan_interval_s": 1.0,
    "multi_table_action_gap_s": 0.35
  },
  "vision_pipeline": [
    "yolo",
    "llm",
    "opencv"
  ],
  "database": {
    "dsn": "${POKER_DB_DSN:-postgresql://poker_bot:__CHANGE_ME__@localhost:5432/poker_db}",
    "mode": "auto",
    "observation_persistence_enabled": true,
    "observation_persistence_path": "log/observation_store.json"
  },
  "fallback_coordinates": {
    "BET_BOX": [
      874,
      660
    ],
    "BET_BTN": [
      879,
      649
    ],
    "CALL": [
      718,
      649
    ],
    "FOLD": [
      556,
      649
    ]
  },
  "hardware": {
    "profile": "auto",
    "vram_cap_override": null,
    "yolo_model_override": null
  },
  "ocr": {
    "enabled_engines": [
      "rapidocr"
    ],
    "mode": "fallback",
    "parallel": false,
    "use_gpu": true,
    "amount_format": {
      "allow_decimals": true,
      "thousands_separators": [
        "space"
      ],
      "decimal_separators": [
        ",",
        "."
      ]
    }
  },
  "rl": {
    "autoload_model": true,
    "enable": true,
    "enable_validated": false
  },
  "preflop": {
    "mode": "precomputed",
    "solutions_path": "models/preflop",
    "live_time_budget_ms": 800
  },
  "tournament": {
    "enabled": false,
    "payouts": []
  },
  "debug": {
    "enabled": false,
    "file_level": "DEBUG",
    "console_level": "DEBUG",
    "log_file": "log/debug.log",
    "rust_log": "debug"
  },
  "yolo": {
    "confidence_threshold": 0.6,
    "model_path": "models/poker_yolo_finetune5.onnx",
    "live_enabled": true,
    "observation_capture": {
      "enabled": false,
      "capture_interval_s": 6.0,
      "require_visual_change": true,
      "max_samples_per_session": 500,
      "dataset_dir": "dataset/runtime_observation"
    }
  }
}
